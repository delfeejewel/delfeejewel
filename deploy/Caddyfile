# Caddy auto-provisions and renews free Let's Encrypt TLS for each domain,
# once that domain's DNS points at this droplet. Until DNS is cut over, cert
# issuance for these names will simply retry — the containers still run and
# can be tested on the droplet via localhost.

delfee.in, www.delfee.in {
	encode zstd gzip
	reverse_proxy storefront:8000
}

api.delfee.in {
	encode zstd gzip
	reverse_proxy backend:9000
}

# Staging — separate containers on the delfee_appnet network (see
# docker-compose.staging.yml). Not deployed by the prod workflow; DNS for
# these two names must point at this droplet before certs will issue.
staging.delfee.in {
	encode zstd gzip
	reverse_proxy storefront-staging:8000
}

api-staging.delfee.in {
	encode zstd gzip
	reverse_proxy backend-staging:9000
}
