# Staging backend runtime env — copy to /opt/delfee/backend-staging.env on the
# droplet and fill in real values. NOT read by prod; NOT committed with real
# secrets. See deploy/docker-compose.staging.yml for how this is wired in.
#
# Hard rules for this file:
#   - RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET must be TEST-mode keys (rzp_test_...).
#     Never put live keys here — this environment runs real checkout code paths.
#   - SHIPROCKET_SIMULATE must stay "true" and NODE_ENV must stay something
#     other than "production" — together these are what make
#     backend/src/modules/shiprocket/service.ts fully simulate every AWB/label/
#     pickup call instead of contacting a real courier (see service.ts:69-88).
#   - Never set any email/notification address in this file (or seeded test
#     data) to itservices007ak@gmail.com.

NODE_ENV=staging
PORT=9000

STORE_CORS=https://staging.delfee.in
ADMIN_CORS=https://api-staging.delfee.in
AUTH_CORS=https://staging.delfee.in,https://api-staging.delfee.in

# Generate distinct secrets for staging — do not reuse prod's.
JWT_SECRET=
COOKIE_SECRET=

# --- Core Medusa data (orders, carts, products): local postgres-staging
# container, NOT Supabase — fully isolated from prod, disposable. Only change
# the host/user/password/db name here if you edited them in
# docker-compose.staging.yml's postgres-staging service. ---
DATABASE_URL=postgresql://medusa:medusa@postgres-staging:5432/medusa-staging

# --- CMS-only reads (store name/address/GSTIN, email sender identity) — these
# intentionally point at the SAME prod Supabase CMS project. Nothing staging
# does writes here; it's the same read-only pattern DEPLOY.md already
# documents for cms_store_info. Copy the values straight from backend/.env. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- File storage — points at the same Supabase Storage bucket as prod
# (product/admin image uploads during a test run); no order data involved. ---
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Shiprocket — SIMULATED, see hard rules above. Email/password are only
# read if SHIPROCKET_SIMULATE is ever accidentally unset, so fill with a
# harmless placeholder rather than a real account's credentials. ---
SHIPROCKET_SIMULATE=true
SHIPROCKET_EMAIL=staging-unused@example.com
SHIPROCKET_PASSWORD=unused
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=

# --- Razorpay — TEST MODE KEYS ONLY (rzp_test_...) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

COD_UPFRONT_PERCENT=10
COD_UPFRONT_THRESHOLD=2000
COD_UPFRONT_FLAT=200

# Used in order/email links — must point at the staging storefront, not prod.
STOREFRONT_URL=https://staging.delfee.in
