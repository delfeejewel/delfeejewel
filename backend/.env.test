# LOCAL E2E ENVIRONMENT — fully isolated from production.
#
# Medusa's loadEnv() loads [.env.test, .env] in that order when NODE_ENV=test,
# and dotenv never overwrites an already-set key — so every value here WINS
# over the same key in .env. That is the entire point of this file: .env holds
# the LIVE Supabase DATABASE_URL and rzp_live_ keys, and nothing in a local
# test run may ever reach them.
#
# Boot with:  NODE_ENV=test npm run dev
# Guard rails below, do not "fix" them:
#   - DATABASE_URL is a LOCAL postgres db (medusa_e2e), never Supabase.
#   - SHIPROCKET_SIMULATE=true + NODE_ENV!=production => every AWB/label/pickup
#     call is faked in-app; the real Shiprocket account is never contacted.
#   - Razorpay keys are deliberately bogus. Local checkout uses COD, which
#     needs no third-party credentials. If you ever add real rzp_test_ keys
#     here, they must be TEST keys — never rzp_live_.

NODE_ENV=test

DATABASE_URL=postgresql://wft-dev16@127.0.0.1:5432/medusa_e2e

# Ports 9000/8000 are deliberately avoided: a long-lived local dev server
# started from the LIVE .env may already be squatting on 9000, and driving
# tests at it would hit production. The e2e stack owns 9010/8010 only.
PORT=9010

STORE_CORS=http://localhost:8010
ADMIN_CORS=http://localhost:9010,http://localhost:8010
AUTH_CORS=http://localhost:9010,http://localhost:8010

JWT_SECRET=local-e2e-jwt-secret-not-used-anywhere-else
COOKIE_SECRET=local-e2e-cookie-secret-not-used-anywhere-else

# Shiprocket: simulated. No credentials on purpose — if simulate ever failed
# to engage, these blanks make the real API calls fail loudly rather than
# silently succeeding against the live account.
SHIPROCKET_SIMULATE=true
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=local-e2e-unused

# Deliberately invalid — see note above.
RAZORPAY_KEY_ID=rzp_test_LOCAL_E2E_PLACEHOLDER
RAZORPAY_KEY_SECRET=local-e2e-placeholder
RAZORPAY_WEBHOOK_SECRET=local-e2e-placeholder

# No S3/Supabase storage locally: unset S3_ENDPOINT makes medusa-config fall
# back to local file storage.
S3_ENDPOINT=

# The weekly live-smoke capability must stay inert here.
LIVE_SMOKE_TEST_ENABLED=false
